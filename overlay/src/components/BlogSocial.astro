---
// The writer's social profiles as icons, in the footer of every page (the share plugin's settings, social.ts).
import type { Network } from "../extras/social";
const { profiles } = Astro.props as { profiles: { net: Network; url: string }[] };
---

{
	profiles.length > 0 && (
		<ul class="bb-social" aria-label="Follow">
			{profiles.map(({ net, url }) => (
				<li>
					<a href={url} rel="me noopener" target="_blank" aria-label={net.label} title={net.label}>
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<path fill="currentColor" d={net.path} />
						</svg>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.bb-social {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2, 8px);
		margin: var(--spacing-4, 16px) 0 0;
		padding: 0;
	}
	.bb-social a {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		border: 1px solid var(--color-border, #ddd);
		color: var(--color-muted, inherit);
		transition: color 0.15s, border-color 0.15s;
	}
	.bb-social a:hover {
		color: var(--color-text, inherit);
		border-color: currentColor;
	}
</style>
