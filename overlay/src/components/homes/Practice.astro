---
// Practice (basic): the firm's name and how to reach it side by side, then articles as a plain,
// dated list with their topic. Made for accountants, solicitors and advisers.
import { formatDate } from "../../utils/locale";

const { posts, hasMore, siteTitle, siteTagline, section, business, contact } = Astro.props;
const href = (p: any) => `/posts/${p.id}`;
const when = (p: any) => (p.data.publishedAt ? formatDate(p.data.publishedAt, "long") : "");
const tel = business?.phone ? business.phone.replace(/[^\d+]/g, "") : "";
---

<header class="band pr-head">
	<div class="frame pr-head__grid">
		<div>
			<h1 class="pr-title">{siteTitle}</h1>
			{siteTagline && <p class="pr-tagline">{siteTagline}</p>}
			<p class="pr-actions">
				{contact && <a class="btn" href="/contact">Book a consultation</a>}
				{tel && <a class={contact ? "pr-call" : "btn"} href={`tel:${tel}`}>Call {business.phone}</a>}
			</p>
		</div>
		{business && (
			<aside class="pr-card" aria-label="Contact details">
				{business.phone && <div><h2>Telephone</h2><p><a href={`tel:${tel}`}>{business.phone}</a></p></div>}
				{business.email && <div><h2>Email</h2><p><a href={`mailto:${business.email}`}>{business.email}</a></p></div>}
				{business.address && <div><h2>Office</h2><p class="pr-lines">{business.address}</p></div>}
				{business.hours && <div><h2>Opening hours</h2><p class="pr-lines">{business.hours}</p></div>}
			</aside>
		)}
	</div>
</header>

<section class="band pr-list" aria-labelledby="pr-insights">
	<div class="frame">
		<h2 id="pr-insights" class="pr-h2">Insights and updates</h2>
		<ul class="pr-rows">
			{posts.slice(0, 8).map((p: any) => (
				<li>
					<a href={href(p)}>
						<span class="pr-topic">{section(p)?.label ?? "Article"}</span>
						<span class="pr-row__title">{p.data.title}</span>
						<span class="pr-row__date">{when(p)}</span>
					</a>
				</li>
			))}
		</ul>
		{hasMore && <p class="pr-all"><a class="arrow-link" href="/posts">All articles</a></p>}
	</div>
</section>

<style>
	.pr-head { padding-block: clamp(3rem, 7vw, 5rem); background: var(--color-fill); border-bottom: 3px solid var(--color-brand); }
	.pr-head__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
	.pr-title { margin: 0; font-family: var(--font-heading); font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.05; }
	.pr-tagline { margin: var(--spacing-4) 0 0; max-width: 32em; font-size: var(--font-size-lg); line-height: 1.6; color: var(--color-text-secondary); }
	.pr-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-4); margin: var(--spacing-6) 0 0; }
	.pr-call { font-weight: 700; color: var(--color-text); }
	.pr-card { display: grid; gap: var(--spacing-5); padding: var(--spacing-8); background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-brand); }
	.pr-card h2 { margin: 0 0 var(--spacing-1); font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
	.pr-card p { margin: 0; font-size: 1.05rem; }
	.pr-card a { color: var(--color-text); font-weight: 600; }
	.pr-lines { white-space: pre-line; line-height: 1.5; }
	.pr-list { padding-block: var(--spacing-12) var(--spacing-16); }
	.pr-h2 { margin: 0 0 var(--spacing-4); font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.1rem); }
	.pr-rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--color-text); }
	.pr-rows a { display: grid; grid-template-columns: 11rem minmax(0, 1fr) auto; gap: var(--spacing-6); align-items: baseline; padding: var(--spacing-5) 0; border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
	.pr-topic { font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-brand); }
	.pr-row__title { font-family: var(--font-heading); font-size: 1.3rem; line-height: 1.3; }
	.pr-rows a:hover .pr-row__title { text-decoration: underline; text-underline-offset: 4px; }
	.pr-row__date { font-size: var(--font-size-sm); color: var(--color-muted); white-space: nowrap; }
	.pr-all { margin: var(--spacing-8) 0 0; }
	@media (max-width: 760px) {
		.pr-head__grid { grid-template-columns: minmax(0, 1fr); }
		.pr-rows a { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-1); }
	}
</style>
