---
// Portfolio: the owner's name set huge, then the work in big pictures. The newest piece fills the
// width; the rest sit in pairs, numbered. Ends with a call to get in touch.
import { Image } from "emdash/ui";

const { posts, hasMore, siteTitle, siteTagline, section, business, contact } = Astro.props;
const work = posts.filter((p: any) => p.data.featured_image);
const notes = posts.filter((p: any) => !p.data.featured_image).slice(0, 4);
const [first, ...pairs] = work.slice(0, 9);
const href = (p: any) => `/posts/${p.id}`;
const n = (i: number) => String(i + 1).padStart(2, "0");
const year = (p: any) => (p.data.publishedAt ? p.data.publishedAt.getFullYear() : "");
---

<header class="pf-hero band">
	<div class="frame">
		{siteTagline && <p class="pf-tagline">{siteTagline}</p>}
		<h1 class="pf-title">{siteTitle}</h1>
		<a class="pf-down" href="#work">Selected work <span aria-hidden="true">↓</span></a>
	</div>
</header>

<section class="band pf-work" id="work" aria-label="Selected work">
	<div class="frame">
		{first && (
			<a class="pf-piece pf-piece--wide" href={href(first)}>
				<span class="pf-piece__media"><Image image={first.data.featured_image} sizes="100vw" priority /></span>
				<span class="pf-piece__cap"><span class="pf-n">01</span><span class="pf-piece__title">{first.data.title}</span><span class="pf-piece__meta">{section(first)?.label ?? ""} {year(first)}</span></span>
			</a>
		)}
		<div class="pf-pairs">
			{pairs.map((p: any, i: number) => (
				<a class="pf-piece" href={href(p)}>
					<span class="pf-piece__media"><Image image={p.data.featured_image} sizes="(min-width: 900px) 50vw, 100vw" /></span>
					<span class="pf-piece__cap"><span class="pf-n">{n(i + 1)}</span><span class="pf-piece__title">{p.data.title}</span><span class="pf-piece__meta">{section(p)?.label ?? ""} {year(p)}</span></span>
				</a>
			))}
		</div>
		{work.length === 0 && <p>Add a featured picture to a post and it shows here as a piece of work.</p>}
		{(hasMore || work.length > 9) && <p class="pf-all"><a class="arrow-link" href="/posts">See everything</a></p>}
	</div>
</section>

{notes.length > 0 && (
	<section class="band pf-notes" aria-labelledby="pf-notes">
		<div class="frame">
			<h2 id="pf-notes">Notes</h2>
			<ul>{notes.map((p: any) => <li><a href={href(p)}>{p.data.title}</a></li>)}</ul>
		</div>
	</section>
)}

{(contact || business?.email) && (
	<section class="band pf-cta" aria-labelledby="pf-cta">
		<div class="frame">
			<h2 id="pf-cta">Have a project in mind?</h2>
			<p class="pf-cta__links">
				{contact && <a class="btn" href="/contact">Get in touch</a>}
				{business?.email && <a class="pf-cta__mail" href={`mailto:${business.email}`}>{business.email}</a>}
			</p>
		</div>
	</section>
)}

<style>
	.pf-hero { padding-block: clamp(4rem, 12vw, 9rem) var(--spacing-12); }
	.pf-tagline { margin: 0 0 var(--spacing-4); max-width: 34em; font-size: var(--font-size-lg); color: var(--color-muted); }
	.pf-title { margin: 0; font-family: var(--font-heading); font-size: clamp(3.4rem, 12vw, 10rem); line-height: .9; letter-spacing: -0.045em; font-weight: 800; overflow-wrap: anywhere; }
	.pf-down { display: inline-flex; gap: .5em; margin-top: var(--spacing-10); color: var(--color-text); font-weight: 600; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }
	.pf-work { padding-block: var(--spacing-4) var(--spacing-16); }
	.pf-piece { display: block; color: inherit; text-decoration: none; }
	.pf-piece__media { display: block; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-fill); }
	.pf-piece__media :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .6s var(--ease-out, ease); }
	.pf-piece--wide .pf-piece__media :global(img) { aspect-ratio: 16 / 8; }
	.pf-piece:hover .pf-piece__media :global(img) { transform: scale(1.035); }
	.pf-piece__cap { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: baseline; gap: var(--spacing-3); padding: var(--spacing-4) 0 0; }
	.pf-n { font-variant-numeric: tabular-nums; color: var(--color-muted); font-size: var(--font-size-sm); }
	.pf-piece__title { font-family: var(--font-heading); font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
	.pf-piece--wide .pf-piece__title { font-size: clamp(1.6rem, 3.4vw, 2.6rem); }
	.pf-piece__meta { color: var(--color-muted); font-size: var(--font-size-sm); white-space: nowrap; }
	.pf-pairs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-12) var(--spacing-8); margin-top: var(--spacing-12); }
	.pf-pairs .pf-piece:nth-child(even) { margin-top: var(--spacing-16); }
	.pf-all { margin: var(--spacing-12) 0 0; }
	.pf-notes { padding-block: var(--spacing-10); border-top: 1px solid var(--color-border); }
	.pf-notes h2 { margin: 0 0 var(--spacing-4); font-size: var(--font-size-sm); letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
	.pf-notes ul { list-style: none; margin: 0; padding: 0; }
	.pf-notes li a { display: block; padding: var(--spacing-3) 0; border-bottom: 1px solid var(--color-border); color: inherit; font-size: var(--font-size-xl); font-weight: 600; text-decoration: none; }
	.pf-cta { padding-block: var(--spacing-16); background: var(--color-text); color: var(--color-bg); }
	.pf-cta h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(2.4rem, 7vw, 5.5rem); line-height: 1; letter-spacing: -0.04em; font-weight: 800; }
	.pf-cta__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-4) var(--spacing-8); margin: var(--spacing-8) 0 0; }
	.pf-cta .btn { background: var(--color-bg); color: var(--color-text); }
	.pf-cta__mail { color: inherit; font-size: var(--font-size-xl); font-weight: 600; overflow-wrap: anywhere; }
	@media (max-width: 760px) {
		.pf-pairs { grid-template-columns: minmax(0, 1fr); }
		.pf-pairs .pf-piece:nth-child(even) { margin-top: 0; }
		.pf-piece__cap { grid-template-columns: 2.4rem minmax(0, 1fr); }
		.pf-piece__meta { grid-column: 2; }
	}
</style>
