---
// Local (basic): a bold coloured banner with the name, a big call button and opening hours, then
// news as picture tiles. For trades, shops, salons and cafés.
import { Image } from "emdash/ui";

const { posts, hasMore, siteTitle, siteTagline, business, contact } = Astro.props;
const href = (p: any) => `/posts/${p.id}`;
const tel = business?.phone ? business.phone.replace(/[^\d+]/g, "") : "";
const tiles = posts.slice(0, 6);
---

<header class="lc-banner">
	<div class="frame lc-banner__grid">
		<div>
			<h1 class="lc-title">{siteTitle}</h1>
			{siteTagline && <p class="lc-tagline">{siteTagline}</p>}
			<p class="lc-actions">
				{tel && <a class="btn lc-btn" href={`tel:${tel}`}>Call {business.phone}</a>}
				{contact && <a class="btn lc-btn lc-btn--light" href="/contact">Send a message</a>}
			</p>
		</div>
		{business && (business.hours || business.address) && (
			<div class="lc-hours">
				{business.hours && <><h2>Open</h2><p class="lc-lines">{business.hours}</p></>}
				{business.address && <><h2>Find us</h2><p class="lc-lines">{business.address}</p></>}
			</div>
		)}
	</div>
</header>

<section class="band lc-news" aria-labelledby="lc-news">
	<div class="frame">
		<h2 id="lc-news" class="lc-h2">What's new</h2>
		<div class="lc-tiles">
			{tiles.map((p: any) => (
				<a class="lc-tile" href={href(p)}>
					{p.data.featured_image ? <Image image={p.data.featured_image} sizes="(min-width: 900px) 380px, 100vw" /> : <span class="lc-tile__blank" />}
					<span class="lc-tile__title">{p.data.title}</span>
				</a>
			))}
		</div>
		{hasMore && <p class="lc-all"><a class="arrow-link" href="/posts">All our news</a></p>}
	</div>
</section>

<style>
	.lc-banner { padding-block: clamp(3rem, 7vw, 5rem); background: var(--color-brand); color: var(--color-on-brand); }
	.lc-banner__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
	.lc-title { margin: 0; font-family: var(--font-heading); font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: .98; font-weight: 800; letter-spacing: -0.035em; }
	.lc-tagline { margin: var(--spacing-4) 0 0; max-width: 30em; font-size: var(--font-size-lg); line-height: 1.5; opacity: .92; }
	.lc-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin: var(--spacing-6) 0 0; }
	.lc-btn { border-radius: 999px; padding: .9rem 1.5rem; font-size: 1.05rem; font-weight: 800; background: var(--color-on-brand); color: var(--color-brand); }
	.lc-btn--light { background: transparent; color: var(--color-on-brand); box-shadow: inset 0 0 0 2px currentColor; }
	.lc-hours { padding: var(--spacing-6) var(--spacing-8); border-radius: 22px; background: color-mix(in srgb, var(--color-on-brand) 14%, transparent); }
	.lc-hours h2 { margin: 0 0 var(--spacing-1); font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; opacity: .85; }
	.lc-hours h2 + p { margin: 0 0 var(--spacing-4); }
	.lc-hours p:last-child { margin-bottom: 0; }
	.lc-lines { white-space: pre-line; font-size: 1.1rem; font-weight: 600; line-height: 1.5; }
	.lc-news { padding-block: var(--spacing-12) var(--spacing-16); }
	.lc-h2 { margin: 0 0 var(--spacing-6); font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; }
	.lc-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-4); }
	.lc-tile { position: relative; display: block; border-radius: 20px; overflow: hidden; background: var(--color-fill); color: #fff; text-decoration: none; }
	.lc-tile :global(img), .lc-tile__blank { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; transition: transform .3s; }
	.lc-tile:hover :global(img) { transform: scale(1.04); }
	.lc-tile__title { position: absolute; inset: auto 0 0; padding: var(--spacing-10) var(--spacing-5) var(--spacing-5); background: linear-gradient(transparent, rgb(0 0 0 / .72)); font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; line-height: 1.2; }
	.lc-all { margin: var(--spacing-8) 0 0; }
	@media (max-width: 860px) { .lc-banner__grid { grid-template-columns: minmax(0, 1fr); } .lc-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 520px) { .lc-tiles { grid-template-columns: minmax(0, 1fr); } }
</style>
