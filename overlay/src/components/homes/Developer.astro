---
// Developer: a blog for people who write code. A terminal-style introduction, the newest post in a
// window, then every post as a dated list grouped by year, with its topic in monospace.
import { formatDate } from "../../utils/locale";

const { posts, hasMore, siteTitle, siteTagline, section, button } = Astro.props;
const [latest, ...rest] = posts;
const href = (p: any) => `/posts/${p.id}`;
const iso = (p: any) => (p.data.publishedAt ? new Date(p.data.publishedAt).toISOString().slice(0, 10) : "");
const mins = (p: any) => Math.max(1, Math.round(JSON.stringify(p.data.content ?? "").split(/\s+/).length / 220));
const years = new Map<string, any[]>();
for (const p of rest) {
	const y = iso(p).slice(0, 4) || "Undated";
	years.set(y, [...(years.get(y) ?? []), p]);
}
const handle = siteTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "blog";
---

<header class="dv-hero band">
	<div class="frame">
		<p class="dv-prompt"><span class="dv-path">~/{handle}</span> <span class="dv-dollar">$</span> cat README.md<span class="dv-caret" aria-hidden="true"></span></p>
		<h1 class="dv-title">{siteTitle}</h1>
		{siteTagline && <p class="dv-tagline">{siteTagline}</p>}
		<p class="dv-links">
			<a href="/posts">./posts</a>
			<a href="/rss.xml">./rss.xml</a>
			{button && <a href={button.link}>{button.text}</a>}
		</p>
	</div>
</header>

{latest && (
	<section class="band dv-latest" aria-labelledby="dv-latest">
		<div class="frame">
			<a class="dv-window" href={href(latest)}>
				<span class="dv-window__bar" aria-hidden="true"><i></i><i></i><i></i><span>latest.md</span></span>
				<span class="dv-window__body">
					<span class="dv-meta">{iso(latest)} · {mins(latest)} min read{section(latest) && <> · #{section(latest).slug}</>}</span>
					<span id="dv-latest" class="dv-window__title">{latest.data.title}</span>
					{latest.data.excerpt && <span class="dv-window__excerpt">{latest.data.excerpt}</span>}
					<span class="dv-window__read">Read post →</span>
				</span>
			</a>
		</div>
	</section>
)}

{years.size > 0 && (
	<section class="band dv-archive" aria-label="All posts">
		<div class="frame">
			{[...years].map(([year, list]) => (
				<div class="dv-year">
					<h2 class="dv-year__label">{year}</h2>
					<ul class="dv-list">
						{list.map((p: any) => (
							<li>
								<time datetime={iso(p)}>{iso(p).slice(5)}</time>
								<a href={href(p)}>{p.data.title}</a>
								{section(p) && <a class="dv-tag" href={`/category/${section(p).slug}`}>#{section(p).slug}</a>}
							</li>
						))}
					</ul>
				</div>
			))}
			{hasMore && <p class="dv-all"><a href="/posts">ls ./posts --all →</a></p>}
		</div>
	</section>
)}

<style>
	.dv-hero { padding-block: clamp(3.5rem, 8vw, 6rem) var(--spacing-8); }
	.dv-prompt { margin: 0; font-family: var(--font-mono); font-size: .95rem; color: var(--color-muted); }
	.dv-path { color: var(--color-brand); }
	.dv-dollar { color: var(--color-text); }
	.dv-caret { display: inline-block; width: .6em; height: 1.1em; margin-left: .15em; vertical-align: -.2em; background: var(--color-brand); animation: dv-blink 1.1s steps(1) infinite; }
	@keyframes dv-blink { 50% { opacity: 0; } }
	@media (prefers-reduced-motion: reduce) { .dv-caret { animation: none; } }
	.dv-title { margin: var(--spacing-4) 0 0; font-size: clamp(2.6rem, 7vw, 4.8rem); line-height: 1; font-weight: 800; letter-spacing: -0.04em; }
	.dv-tagline { margin: var(--spacing-4) 0 0; max-width: 38em; font-size: var(--font-size-lg); line-height: 1.6; color: var(--color-text-secondary); }
	.dv-links { display: flex; flex-wrap: wrap; gap: var(--spacing-2) var(--spacing-5); margin: var(--spacing-6) 0 0; font-family: var(--font-mono); font-size: .95rem; }
	.dv-links a { color: var(--color-brand); text-decoration: none; border-bottom: 1px dashed currentColor; }
	.dv-latest { padding-block: var(--spacing-6) var(--spacing-10); }
	.dv-window { display: block; border: 1px solid var(--color-border-strong); border-radius: 14px; overflow: hidden; background: var(--color-surface); color: inherit; text-decoration: none; box-shadow: 0 24px 50px -36px rgb(0 0 0 / .5); transition: border-color .15s; }
	.dv-window:hover { border-color: var(--color-brand); }
	.dv-window__bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--color-fill); border-bottom: 1px solid var(--color-border); font-family: var(--font-mono); font-size: .8rem; color: var(--color-muted); }
	.dv-window__bar i { width: 12px; height: 12px; border-radius: 50%; background: var(--color-border-strong); }
	.dv-window__bar i:first-child { background: #ff5f57; } .dv-window__bar i:nth-child(2) { background: #febc2e; } .dv-window__bar i:nth-child(3) { background: #28c840; }
	.dv-window__bar span { margin-left: auto; margin-right: auto; }
	.dv-window__body { display: grid; gap: var(--spacing-3); padding: clamp(1.5rem, 4vw, 2.75rem); }
	.dv-meta { font-family: var(--font-mono); font-size: .85rem; color: var(--color-muted); }
	.dv-window__title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; }
	.dv-window__excerpt { max-width: 44em; font-size: 1.1rem; line-height: 1.6; color: var(--color-text-secondary); }
	.dv-window__read { font-family: var(--font-mono); font-size: .95rem; color: var(--color-brand); }
	.dv-archive { padding-block: var(--spacing-4) var(--spacing-16); }
	.dv-year { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--spacing-6); padding-block: var(--spacing-6); border-top: 1px solid var(--color-border); }
	.dv-year:first-child { border-top: 0; }
	.dv-year__label { margin: 0; font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600; color: var(--color-muted); }
	.dv-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-1); }
	.dv-list li { display: flex; align-items: baseline; gap: var(--spacing-4); padding: var(--spacing-2) 0; }
	.dv-list time { flex: none; font-family: var(--font-mono); font-size: .9rem; color: var(--color-muted); }
	.dv-list a:not(.dv-tag) { color: inherit; font-size: 1.12rem; font-weight: 600; text-decoration: none; }
	.dv-list a:not(.dv-tag):hover { color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
	.dv-tag { margin-left: auto; flex: none; font-family: var(--font-mono); font-size: .82rem; color: var(--color-brand); text-decoration: none; }
	.dv-all { margin: var(--spacing-6) 0 0; font-family: var(--font-mono); }
	.dv-all a { color: var(--color-brand); }
	@media (max-width: 640px) {
		.dv-year { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-2); }
		.dv-list li { flex-wrap: wrap; gap: var(--spacing-1) var(--spacing-3); }
		.dv-tag { margin-left: 0; }
	}
</style>
