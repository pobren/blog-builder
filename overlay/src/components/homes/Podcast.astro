---
// Podcast: the show's artwork and name up front with a listen button, the newest episode as a big
// card, then every episode numbered. Episode pages hold the audio player, notes and links.
import { Image } from "emdash/ui";
import { formatDate } from "../../utils/locale";

const { posts, hasMore, siteTitle, siteTagline, button } = Astro.props;
const art = posts.find((p: any) => p.data.featured_image);
const [latest, ...rest] = posts;
const href = (p: any) => `/posts/${p.id}`;
const when = (p: any) => (p.data.publishedAt ? formatDate(p.data.publishedAt, "long") : "");
// Episode numbers only make sense when every episode is on the page.
const no = (i: number) => (hasMore ? null : posts.length - i);
---

<header class="pc-hero band">
	<div class="frame pc-hero__grid">
		{art && <span class="pc-art"><Image image={art.data.featured_image} sizes="(min-width: 900px) 360px, 70vw" priority /></span>}
		<div class="pc-hero__text">
			<p class="pc-kicker"><span class="pc-dot" aria-hidden="true"></span>A podcast</p>
			<h1 class="pc-title">{siteTitle}</h1>
			{siteTagline && <p class="pc-tagline">{siteTagline}</p>}
			<p class="pc-actions">
				{latest && <a class="btn pc-play" href={href(latest)}><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>Play the latest episode</a>}
				{button && <a class="pc-listen" href={button.link}>{button.text}</a>}
				<a class="pc-listen" href="/rss.xml">RSS feed</a>
			</p>
		</div>
	</div>
</header>

{latest && (
	<section class="band pc-latest" aria-labelledby="pc-latest">
		<div class="frame">
			<a class="pc-card" href={href(latest)}>
				<span class="pc-card__meta">Latest episode{no(0) && <> · Episode {no(0)}</>} · {when(latest)}</span>
				<span id="pc-latest" class="pc-card__title">{latest.data.title}</span>
				{latest.data.excerpt && <span class="pc-card__excerpt">{latest.data.excerpt}</span>}
				<span class="pc-wave" aria-hidden="true">{Array.from({ length: 64 }, (_, i) => <i style={`--h:${20 + Math.round(Math.abs(Math.sin(i * 1.7) * Math.cos(i * .45)) * 80)}%`} />)}</span>
				<span class="pc-card__go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>Listen now</span>
			</a>
		</div>
	</section>
)}

{rest.length > 0 && (
	<section class="band pc-eps" aria-labelledby="pc-eps">
		<div class="frame">
			<h2 id="pc-eps" class="pc-h2">All episodes</h2>
			<ol class="pc-list">
				{rest.map((p: any, i: number) => (
					<li>
						<a href={href(p)}>
							<span class="pc-no">{no(i + 1) ?? ""}</span>
							<span class="pc-list__body">
								<span class="pc-list__title">{p.data.title}</span>
								{p.data.excerpt && <span class="pc-list__excerpt">{p.data.excerpt}</span>}
							</span>
							<span class="pc-list__date">{when(p)}</span>
							<span class="pc-list__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
						</a>
					</li>
				))}
			</ol>
			{hasMore && <p class="pc-all"><a class="arrow-link" href="/posts">Every episode</a></p>}
		</div>
	</section>
)}

<style>
	.pc-hero { padding-block: clamp(3rem, 7vw, 5.5rem); background: radial-gradient(90% 120% at 0% 0%, color-mix(in srgb, var(--color-brand) 22%, transparent), transparent 60%); }
	.pc-hero__grid { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
	.pc-art { display: block; border-radius: 22px; overflow: hidden; box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--color-brand) 70%, #000); }
	.pc-art :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
	.pc-kicker { display: inline-flex; align-items: center; gap: .5rem; margin: 0; font-weight: 700; font-size: var(--font-size-sm); letter-spacing: .12em; text-transform: uppercase; color: var(--color-brand); }
	.pc-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-brand); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand) 25%, transparent); }
	.pc-title { margin: var(--spacing-3) 0 0; font-family: var(--font-heading); font-size: clamp(2.6rem, 7vw, 5rem); line-height: .95; font-weight: 800; letter-spacing: -0.04em; }
	.pc-tagline { margin: var(--spacing-4) 0 0; max-width: 34em; font-size: var(--font-size-lg); line-height: 1.55; color: var(--color-text-secondary); }
	.pc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-3) var(--spacing-5); margin: var(--spacing-8) 0 0; }
	.pc-play { display: inline-flex; align-items: center; gap: .5rem; border-radius: 999px; padding: .9rem 1.5rem .9rem 1.2rem; font-weight: 800; }
	.pc-play svg { width: 20px; height: 20px; }
	.pc-listen { font-weight: 700; color: var(--color-text); }
	.pc-latest { padding-block: var(--spacing-10) var(--spacing-12); }
	.pc-card { display: grid; gap: var(--spacing-3); padding: clamp(1.5rem, 4vw, 2.75rem); border-radius: 24px; background: var(--bb-deep); color: #fff; text-decoration: none; }
	.pc-card__meta { font-size: var(--font-size-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-brand); }
	.pc-card__title { font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; }
	.pc-card__excerpt { max-width: 42em; font-size: 1.1rem; line-height: 1.55; opacity: .8; }
	.pc-wave { display: flex; align-items: center; gap: 3px; height: 56px; margin-top: var(--spacing-3); }
	.pc-wave i { flex: 1; height: var(--h); border-radius: 2px; background: color-mix(in srgb, #fff 30%, transparent); }
	.pc-wave i:nth-child(-n + 22) { background: var(--color-brand); }
	.pc-card__go { display: inline-flex; align-items: center; gap: .45rem; font-weight: 800; color: var(--color-brand); }
	.pc-card__go svg { width: 22px; height: 22px; }
	.pc-card:hover .pc-card__title { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
	.pc-eps { padding-block: var(--spacing-12) var(--spacing-16); }
	.pc-h2 { margin: 0 0 var(--spacing-4); font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.03em; }
	.pc-list { list-style: none; margin: 0; padding: 0; }
	.pc-list a { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto 48px; gap: var(--spacing-4); align-items: center; padding: var(--spacing-5) 0; border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
	.pc-no { font-family: var(--font-heading); font-size: 1.6rem; font-weight: 800; color: var(--color-muted); font-variant-numeric: tabular-nums; }
	.pc-list__body { display: grid; gap: 4px; }
	.pc-list__title { font-size: 1.2rem; font-weight: 700; line-height: 1.25; }
	.pc-list__excerpt { color: var(--color-muted); line-height: 1.5; }
	.pc-list__date { font-size: var(--font-size-sm); color: var(--color-muted); white-space: nowrap; }
	.pc-list__play { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--color-border-strong); color: var(--color-text); transition: background .15s, color .15s, border-color .15s; }
	.pc-list__play svg { width: 18px; height: 18px; margin-left: 2px; }
	.pc-list a:hover .pc-list__play { background: var(--color-brand); border-color: var(--color-brand); color: var(--color-on-brand); }
	.pc-list a:hover .pc-list__title { color: var(--color-brand); }
	.pc-all { margin: var(--spacing-8) 0 0; }
	@media (max-width: 760px) {
		.pc-hero__grid { grid-template-columns: minmax(0, 1fr); }
		.pc-art { max-width: 280px; }
		.pc-list a { grid-template-columns: 2.5rem minmax(0, 1fr) 44px; }
		.pc-list__date { display: none; }
	}
</style>
