---
// SaaS: a product home page for creators and solo founders. A bold promise with the owner's main
// button (Blog Builder plugin settings), the newest picture framed as a product screenshot, the posts as an
// updates timeline, any guides as cards, and the button again at the end.
import { Image } from "emdash/ui";
import { formatDate } from "../../utils/locale";

const { posts, hasMore, siteTitle, siteTagline, section, button } = Astro.props;
const latest = posts[0];
const shot = posts.find((p: any) => p.data.featured_image);
const updates = posts.slice(0, 6);
const guides = posts.filter((p: any) => p.data.featured_image && /guide|how|tutorial/i.test(section(p)?.slug ?? "")).slice(0, 3);
const href = (p: any) => `/posts/${p.id}`;
const external = button && /^https?:/.test(button.link);
---

<header class="sa-hero band">
	<div class="frame sa-hero__inner">
		{latest && (
			<a class="sa-pill" href={href(latest)}><span class="sa-pill__new">New</span>{latest.data.title}<span aria-hidden="true">→</span></a>
		)}
		<p class="sa-name">{siteTitle}</p>
		<h1 class="sa-title">{siteTagline || siteTitle}</h1>
		<p class="sa-actions">
			{button && <a class="btn sa-btn" href={button.link} rel={external ? "noopener" : undefined}>{button.text}</a>}
			<a class="btn sa-btn sa-btn--ghost" href="#updates">See what's new</a>
		</p>
		{shot && (
			<div class="sa-shot">
				<div class="sa-shot__bar" aria-hidden="true"><i></i><i></i><i></i></div>
				<Image image={shot.data.featured_image} sizes="(min-width: 1100px) 1040px, 100vw" priority />
			</div>
		)}
	</div>
</header>

{updates.length > 0 && (
	<section class="band sa-updates" id="updates" aria-labelledby="sa-updates">
		<div class="frame sa-updates__grid">
			<div class="sa-updates__head">
				<p class="sa-eyebrow">Updates</p>
				<h2 id="sa-updates" class="sa-h2">What's new in {siteTitle}</h2>
				<p class="sa-sub">Every new feature, fix and guide, newest first.</p>
				{hasMore && <a class="arrow-link" href="/posts">Every update</a>}
			</div>
			<ol class="sa-timeline">
				{updates.map((p: any) => (
					<li>
						<span class="sa-dot" aria-hidden="true"></span>
						<p class="sa-when">
							{p.data.publishedAt && <time datetime={p.data.publishedAt.toISOString()}>{formatDate(p.data.publishedAt, "long")}</time>}
							{section(p) && <span class="sa-chip">{section(p).label}</span>}
						</p>
						<h3><a href={href(p)}>{p.data.title}</a></h3>
						{p.data.excerpt && <p class="sa-excerpt">{p.data.excerpt}</p>}
					</li>
				))}
			</ol>
		</div>
	</section>
)}

{guides.length > 0 && (
	<section class="band sa-guides" aria-labelledby="sa-guides">
		<div class="frame">
			<p class="sa-eyebrow">Guides</p>
			<h2 id="sa-guides" class="sa-h2">Get more from {siteTitle}</h2>
			<div class="sa-cards">
				{guides.map((p: any) => (
					<a class="sa-card" href={href(p)}>
						<Image image={p.data.featured_image} sizes="(min-width: 900px) 340px, 100vw" />
						<span class="sa-card__title">{p.data.title}</span>
						{p.data.excerpt && <span class="sa-card__excerpt">{p.data.excerpt}</span>}
					</a>
				))}
			</div>
		</div>
	</section>
)}

{button && (
	<section class="band sa-cta" aria-labelledby="sa-cta">
		<div class="frame">
			<div class="sa-cta__inner">
				<h2 id="sa-cta">Ready to try {siteTitle}?</h2>
				<a class="btn sa-btn" href={button.link} rel={external ? "noopener" : undefined}>{button.text}</a>
			</div>
		</div>
	</section>
)}

<style>
	.sa-hero { position: relative; padding-block: clamp(3.5rem, 9vw, 7rem) 0; overflow: hidden; text-align: center; }
	.sa-hero::before { content: ""; position: absolute; inset: -20% -10% auto; height: 80%; background: radial-gradient(50% 60% at 50% 40%, var(--bb-glow, rgb(124 92 255 / .35)), transparent 70%); pointer-events: none; }
	.sa-hero__inner { position: relative; display: flex; flex-direction: column; align-items: center; }
	.sa-pill { display: inline-flex; align-items: center; gap: .6em; max-width: 100%; padding: .4rem .9rem .4rem .4rem; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-text-secondary); font-size: var(--font-size-sm); text-decoration: none; }
	.sa-pill:hover { border-color: var(--color-brand); }
	.sa-pill__new { padding: .15rem .6rem; border-radius: 999px; background: var(--color-brand); color: var(--color-on-brand); font-weight: 700; font-size: .78rem; }
	.sa-name { margin: var(--spacing-8) 0 0; font-weight: 700; color: var(--color-brand); letter-spacing: .02em; }
	.sa-title { margin: var(--spacing-3) 0 0; max-width: 15em; font-family: var(--font-heading); font-size: clamp(2.6rem, 7vw, 5.4rem); line-height: 1; letter-spacing: -0.04em; font-weight: 800; text-wrap: balance; background: linear-gradient(180deg, var(--color-text) 30%, color-mix(in srgb, var(--color-text) 55%, var(--color-brand))); -webkit-background-clip: text; background-clip: text; color: transparent; }
	.sa-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-3); margin: var(--spacing-8) 0 0; }
	.sa-btn { padding: .95rem 1.5rem; border-radius: 12px; font-weight: 700; font-size: 1.02rem; }
	.sa-btn--ghost { background: var(--color-surface); color: var(--color-text); box-shadow: inset 0 0 0 1px var(--color-border-strong); }
	.sa-shot { width: min(100%, 1040px); margin-top: var(--spacing-12); border: 1px solid var(--color-border-strong); border-bottom: 0; border-radius: 14px 14px 0 0; overflow: hidden; background: var(--color-surface); box-shadow: 0 -10px 60px -20px var(--bb-glow, rgb(124 92 255 / .5)), 0 30px 80px -30px rgb(0 0 0 / .5); }
	.sa-shot__bar { display: flex; gap: 7px; padding: 12px 14px; border-bottom: 1px solid var(--color-border); }
	.sa-shot__bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--color-border-strong); }
	.sa-shot :global(img) { display: block; width: 100%; height: auto; }
	.sa-updates { padding-block: var(--spacing-16); border-top: 1px solid var(--color-border); }
	.sa-updates__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: var(--spacing-12); }
	.sa-updates__head { position: sticky; top: calc(var(--nav-height, 64px) + 2rem); align-self: start; }
	.sa-eyebrow { margin: 0; color: var(--color-brand); font-weight: 700; font-size: var(--font-size-sm); letter-spacing: .06em; text-transform: uppercase; }
	.sa-h2 { margin: var(--spacing-2) 0 var(--spacing-3); font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; }
	.sa-sub { margin: 0 0 var(--spacing-4); color: var(--color-muted); font-size: var(--font-size-lg); }
	.sa-timeline { list-style: none; margin: 0; padding: 0 0 0 var(--spacing-8); border-left: 2px solid var(--color-border); }
	.sa-timeline li { position: relative; padding-bottom: var(--spacing-10); }
	.sa-timeline li:last-child { padding-bottom: 0; }
	.sa-dot { position: absolute; left: calc(-1 * var(--spacing-8) - 7px); top: .35rem; width: 12px; height: 12px; border-radius: 50%; background: var(--color-brand); box-shadow: 0 0 0 5px var(--color-bg), 0 0 0 7px color-mix(in srgb, var(--color-brand) 35%, transparent); }
	.sa-when { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-3); margin: 0 0 var(--spacing-2); color: var(--color-muted); font-size: var(--font-size-sm); }
	.sa-chip { padding: .1rem .55rem; border-radius: 6px; background: color-mix(in srgb, var(--color-brand) 14%, transparent); color: var(--color-brand); font-weight: 700; font-size: .75rem; }
	.sa-timeline h3 { margin: 0 0 var(--spacing-2); font-family: var(--font-heading); font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.02em; }
	.sa-timeline h3 a { color: inherit; text-decoration: none; }
	.sa-timeline h3 a:hover { color: var(--color-brand); }
	.sa-excerpt { margin: 0; color: var(--color-text-secondary); line-height: 1.6; }
	.sa-guides { padding-block: var(--spacing-16); background: var(--color-fill); }
	.sa-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-6); margin-top: var(--spacing-8); }
	.sa-card { display: grid; gap: var(--spacing-2); padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: 16px; background: var(--color-surface); color: inherit; text-decoration: none; transition: border-color .2s, transform .2s; }
	.sa-card:hover { border-color: var(--color-brand); transform: translateY(-2px); }
	.sa-card :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; margin-bottom: var(--spacing-2); }
	.sa-card__title { padding-inline: var(--spacing-2); font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; }
	.sa-card__excerpt { padding: 0 var(--spacing-2) var(--spacing-2); color: var(--color-muted); line-height: 1.5; }
	.sa-cta { padding-block: var(--spacing-16); }
	.sa-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-6); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 24px; background: linear-gradient(135deg, var(--color-brand), color-mix(in srgb, var(--color-brand) 55%, #ff6ad5)); color: var(--color-on-brand); }
	.sa-cta h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(1.9rem, 4vw, 3rem); letter-spacing: -0.035em; font-weight: 800; line-height: 1.05; }
	.sa-cta .sa-btn { background: #fff; color: #17122b; }
	@media (max-width: 860px) {
		.sa-updates__grid, .sa-cards { grid-template-columns: minmax(0, 1fr); }
		.sa-updates__head { position: static; }
	}
</style>
