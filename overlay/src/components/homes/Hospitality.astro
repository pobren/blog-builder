---
// Hospitality: a full-width welcome picture with the name over it, then opening times, how to find
// the place and how to book, then the latest news as cards. The details come from the Blog Builder plugin.
import { Image } from "emdash/ui";
import { formatDate } from "../../utils/locale";

const { posts, hasMore, siteTitle, siteTagline, business, contact } = Astro.props;
const hero = posts.find((p: any) => p.data.featured_image);
const news = posts.slice(0, 6);
const href = (p: any) => `/posts/${p.id}`;
const tel = business?.phone ? business.phone.replace(/[^\d+]/g, "") : "";
const directions = business?.address ? `https://www.openstreetmap.org/search?query=${encodeURIComponent(business.address.replace(/\s*\n\s*/g, ", "))}` : null;
---

<header class="hs-hero">
	{hero && <span class="hs-hero__media"><Image image={hero.data.featured_image} sizes="100vw" priority /></span>}
	<div class="frame hs-hero__inner">
		<p class="hs-welcome">Welcome to</p>
		<h1 class="hs-title">{siteTitle}</h1>
		{siteTagline && <p class="hs-tagline">{siteTagline}</p>}
		<p class="hs-actions">
			{tel && <a class="btn hs-btn" href={`tel:${tel}`}>Call to book</a>}
			{contact && <a class="btn hs-btn hs-btn--ghost" href="/contact">Send us a message</a>}
			{!tel && !contact && <a class="btn hs-btn" href="#news">What's new</a>}
		</p>
	</div>
</header>

{business && (business.hours || business.address || business.phone || business.email) && (
	<section class="band hs-info" aria-label="Visit us">
		<div class="frame hs-info__grid">
			{business.hours && (
				<div>
					<h2>Opening times</h2>
					<p class="hs-lines">{business.hours}</p>
				</div>
			)}
			{business.address && (
				<div>
					<h2>Find us</h2>
					<p class="hs-lines">{business.address}</p>
					{directions && <a class="arrow-link" href={directions} rel="noopener">Get directions</a>}
				</div>
			)}
			{(business.phone || business.email) && (
				<div>
					<h2>Book a table</h2>
					{business.phone && <p><a class="hs-big" href={`tel:${tel}`}>{business.phone}</a></p>}
					{business.email && <p><a href={`mailto:${business.email}`}>{business.email}</a></p>}
				</div>
			)}
		</div>
	</section>
)}

{news.length > 0 && (
	<section class="band hs-news" id="news" aria-labelledby="hs-news">
		<div class="frame">
			<p class="hs-eyebrow">From the kitchen</p>
			<h2 id="hs-news" class="hs-h2">What's new</h2>
			<div class="hs-cards">
				{news.map((p: any) => (
					<a class="hs-card" href={href(p)}>
						<span class="hs-card__media">{p.data.featured_image ? <Image image={p.data.featured_image} sizes="(min-width: 900px) 360px, 100vw" /> : <span class="hs-card__blank" />}</span>
						<span class="hs-card__body">
							{p.data.publishedAt && <span class="hs-card__date">{formatDate(p.data.publishedAt, "long")}</span>}
							<span class="hs-card__title">{p.data.title}</span>
							{p.data.excerpt && <span class="hs-card__excerpt">{p.data.excerpt}</span>}
						</span>
					</a>
				))}
			</div>
			{hasMore && <p class="hs-all"><a class="arrow-link" href="/posts">All our news</a></p>}
		</div>
	</section>
)}

<style>
	.hs-hero { position: relative; display: grid; align-items: end; min-height: min(78vh, 760px); color: #fff; background: #1d2a22; overflow: hidden; }
	.hs-hero__media { position: absolute; inset: 0; }
	.hs-hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.hs-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / .05) 20%, rgb(12 20 15 / .78) 100%); }
	.hs-hero__inner { position: relative; z-index: 1; padding-block: var(--spacing-16) var(--spacing-12); }
	.hs-welcome { margin: 0; font-family: var(--font-heading); font-style: italic; font-size: var(--font-size-xl); opacity: .9; }
	.hs-title { margin: var(--spacing-2) 0 0; font-family: var(--font-heading); font-size: clamp(3rem, 9vw, 7rem); line-height: .95; letter-spacing: -0.02em; font-weight: 600; text-wrap: balance; }
	.hs-tagline { margin: var(--spacing-4) 0 0; max-width: 32em; font-size: var(--font-size-lg); opacity: .92; }
	.hs-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin: var(--spacing-8) 0 0; }
	.hs-btn { padding: .95rem 1.6rem; font-size: 1.05rem; border-radius: 999px; background: var(--color-brand); color: var(--color-on-brand); }
	.hs-btn--ghost { background: rgb(255 255 255 / .14); color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .6); backdrop-filter: blur(6px); }
	.hs-info { padding-block: var(--spacing-10); background: var(--color-fill); }
	.hs-info__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--spacing-8); }
	.hs-info h2 { margin: 0 0 var(--spacing-3); font-family: var(--font-heading); font-size: var(--font-size-xl); font-weight: 600; }
	.hs-info p { margin: 0 0 var(--spacing-2); }
	.hs-lines { white-space: pre-line; line-height: 1.6; }
	.hs-big { font-family: var(--font-heading); font-size: var(--font-size-2xl); font-weight: 600; color: var(--color-brand); text-decoration: none; }
	.hs-news { padding-block: var(--spacing-16); }
	.hs-eyebrow { margin: 0; text-align: center; font-family: var(--font-heading); font-style: italic; font-size: var(--font-size-lg); color: var(--color-brand); }
	.hs-h2 { margin: var(--spacing-1) 0 var(--spacing-10); text-align: center; font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600; }
	.hs-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-8); }
	.hs-card { display: flex; flex-direction: column; color: inherit; text-decoration: none; background: var(--color-surface); border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 1px 2px rgb(0 0 0 / .06), 0 12px 30px -18px rgb(0 0 0 / .35); transition: transform .25s ease; }
	.hs-card:hover { transform: translateY(-3px); }
	.hs-card__media :global(img), .hs-card__blank { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--color-fill-strong); }
	.hs-card__body { display: grid; gap: var(--spacing-2); padding: var(--spacing-5) var(--spacing-5) var(--spacing-6); }
	.hs-card__date { font-size: var(--font-size-sm); color: var(--color-muted); }
	.hs-card__title { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 600; line-height: 1.2; }
	.hs-card__excerpt { color: var(--color-text-secondary); line-height: 1.5; }
	.hs-all { margin: var(--spacing-10) 0 0; text-align: center; }
	@media (max-width: 900px) { .hs-cards { grid-template-columns: minmax(0, 1fr); } }
</style>
