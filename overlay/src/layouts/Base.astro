---
import { siteKeyFor } from "../turnstile";
import {
	getMenuWithCacheHint,
	getPluginSetting,
	getSiteSettingsWithCacheHint,
} from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { businessDetails, currentTheme, pluginOn } from "../theme";
import { designCss, designFrom, fontsFor, withPreview } from "../design";
import BlogThemeHead from "../components/BlogThemeHead.astro";
import BlogBusiness from "../components/BlogBusiness.astro";
import BlogShare from "../components/BlogShare.astro";
import BlogSignup from "../components/BlogSignup.astro";
import BlogSlideUp from "../components/BlogSlideUp.astro";
import BlogForms from "../components/BlogForms.astro";
import BlogSocial from "../components/BlogSocial.astro";
import BlogBanner from "../components/BlogBanner.astro";
import { NETWORKS, handleOf, profileUrl } from "../extras/social";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
// The writer's Site icon (Settings), or the blog's first letter (src/favicon.ts).
const siteIcon = (settingsResult.data as { favicon?: { url?: string; contentType?: string } } | undefined)?.favicon;
const faviconUrl = siteIcon?.url || "/favicon.svg";
const faviconType = siteIcon?.url ? siteIcon.contentType : "image/svg+xml";
// iPhones only take a PNG or JPEG for the home screen; anything else gets the letter icon (src/touch-icon.ts).
const touchIconUrl = siteIcon?.url && /^image\/(png|jpeg)$/.test(siteIcon.contentType ?? "") ? siteIcon.url : "/apple-touch-icon.png";
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

// The "Made with Blog Builder" footer link, on unless turned off in the Blog
// Builder plugin's settings. EmDash stores no value until the setting is saved.
const showPoweredBy =
	(await getPluginSetting<boolean>("builder", "showPoweredBy")) ?? true;

// The theme the owner picked (src/theme.ts), and Blog Builder's extras:
// business details for business themes, share buttons and the newsletter
// sign-up (src/extras/).
const themeInfo = await currentTheme();
// The writer's own colour, fonts, light or dark, and reading bar (src/design.ts), from the plugin's settings.
const designSetting = async (key: string): Promise<unknown> => {
	try {
		return await getPluginSetting<unknown>("builder", key);
	} catch {
		return undefined;
	}
};
const [accentSaved, fontSaved, schemeSaved, barSaved] = await Promise.all(["accent", "fontPair", "scheme", "readingBar"].map(designSetting));
const design = withPreview(designFrom({ accent: accentSaved, fontPair: fontSaved, scheme: schemeSaved, readingBar: barSaved }), Astro.url.searchParams);
const designStyle = designCss(design);
// Fonts the design needs that the theme doesn't load already.
const designFonts = fontsFor(design).filter((f) => f !== themeInfo.theme.font);
const isHome = (Astro.url.pathname.replace(/\/$/, "") || "/") === "/";
const isPost = type === "article" && content?.collection === "posts";
// Themes with their own home page place the details themselves (src/components/homes/).
const business = isHome && themeInfo.theme.business && !themeInfo.theme.home ? await businessDetails() : null;
const [contactOn, shareOn, signupOn, signupOnHome, slideUpOn] = await Promise.all([
	business ? pluginOn("contact", "enabled", false) : false,
	isPost ? pluginOn("share", "enabled", true) : false,
	// The sign-up box is on until the owner turns it off (Newsletter settings).
	isPost || isHome ? pluginOn("newsletter", "enabled", true) : false,
	isHome ? pluginOn("newsletter", "onHome", true) : false,
	// A small box that slides up once a reader is halfway down a post (Newsletter settings).
	isPost ? pluginOn("newsletter", "slideUp", false) : false,
]);
const showSignup = signupOn && (isPost || signupOnHome);
const newsletterText = async (key: string) => {
	try {
		return ((await getPluginSetting<string>("newsletter", key)) ?? "").trim();
	} catch {
		return "";
	}
};
const signup = showSignup
	? {
			heading: (await newsletterText("heading")) || "Get new posts by email",
			blurb: (await newsletterText("blurb")) || "Leave your email address and we'll let you know when there's something new.",
			siteKey: siteKeyFor(await newsletterText("turnstileSiteKey"), Astro.url.hostname),
			askName: (await newsletterText("askName")) || "optional",
			button: (await newsletterText("buttonLabel")) || "Sign up",
		}
	: null;
const slideUp = signup && signupOn && slideUpOn ? signup : null;
const shareUrl = canonical || Astro.url.href;

// The writer's social profiles (the share plugin's settings) as footer icons, and their X and Bluesky handles
// credited in shares; and the promo banner across the top (the Blog Builder plugin's settings).
const textSetting = async (plugin: string, key: string) => {
	try {
		return String((await getPluginSetting<string>(plugin, key)) ?? "").trim();
	} catch {
		return "";
	}
};
const socialTyped = Object.fromEntries(await Promise.all(NETWORKS.map(async (n) => [n.id, await textSetting("share", `social_${n.id}`)] as const)));
const profiles = NETWORKS.map((net) => ({ net, url: profileUrl(net, socialTyped[net.id]) })).filter((p): p is { net: (typeof NETWORKS)[number]; url: string } => !!p.url);
const banner = { text: await textSetting("builder", "bannerText"), link: await textSetting("builder", "bannerLink"), button: await textSetting("builder", "bannerButton") };
if (!/^(https:\/\/|\/)/.test(banner.link)) banner.link = "";

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const monogram = [...siteTitle.trim()][0]?.toUpperCase() ?? "";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} data-bb-theme={themeInfo.theme.id} data-bb-scheme={design.scheme === "auto" ? undefined : design.scheme} data-bb-preview={Astro.url.searchParams.get("bb-preview") === "1" ? design.scheme : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" href={faviconUrl} type={faviconType} />
		<link rel="apple-touch-icon" href={touchIconUrl} />
		<EmDashHead page={pageCtx} />
		<BlogThemeHead info={themeInfo} />
		{designFonts.includes("serif") && <Font cssVariable="--font-serif" />}
		{designFonts.includes("display") && <Font cssVariable="--font-display" />}
		{/* Light or dark, as chosen (footer switch or Design tab). Unlayered, because other unlayered sheets on the
		   page set color-scheme on :root and would beat the @layer base rules below. */}
		<style is:inline set:html="@supports (color: light-dark(#000, #fff)){:root.light{color-scheme:light}:root.dark{color-scheme:dark}}" />
		{designStyle && <style is:inline set:html={designStyle} />}
		{/* The Design tab's preview: the blog as readers see it, without the editing bar. */}
		{Astro.url.searchParams.get("bb-preview") === "1" && <style is:inline>#emdash-toolbar{display:none!important}</style>}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				// The reader's own choice first, then the writer's (Design tab).
				// In the Design tab's preview, the writer's choice wins over their own cookie.
				var html = document.documentElement;
				var preview = html.getAttribute("data-bb-preview");
				var theme = preview && preview !== "auto" ? preview : row ? row.slice(6) : html.getAttribute("data-bb-scheme");
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		{isPost && design.bar && (
			<>
				<div class="bb-readbar" aria-hidden="true"></div>
				<script is:inline>
					(function () {
						var bar = document.querySelector(".bb-readbar");
						var body = document.querySelector("[data-post-content]") || document.querySelector("main");
						if (!bar || !body) return;
						var draw = function () {
							var box = body.getBoundingClientRect();
							var seen = (window.innerHeight - box.top) / Math.max(box.height, 1);
							bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, seen)) + ")";
						};
						window.addEventListener("scroll", draw, { passive: true });
						window.addEventListener("resize", draw);
						draw();
					})();
				</script>
			</>
		)}
		{banner.text && <BlogBanner {...banner} />}
		<header class="site-header">
			<div class="frame site-header__inner">
				<a href="/" class="brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="brand__logo"
							/>
						) : (
							<>
								{monogram && (
									<span class="brand__mark" aria-hidden="true">
										{monogram}
									</span>
								)}
								<span class="brand__name">{siteTitle}</span>
							</>
						)
					}
				</a>
				{
					menuItems.length > 0 && (
						<nav class="site-nav" aria-label="Main">
							<ul>
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
											aria-current={navCurrent(item.url)}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-header__actions">
					<div class="site-search" role="search" aria-label="Site">
						<svg
							class="site-search__icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
						<LiveSearch
							placeholder="Search"
							class="site-search__field"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
						/>
						<kbd class="site-search__kbd" aria-hidden="true"
							><span dir="ltr">⌘K</span></kbd
						>
					</div>
					<a
						href="/search"
						class="icon-btn site-search-link"
						aria-label="Search"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
					</a>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="btn btn--ghost btn--sm nav-admin">
								Admin
							</a>
						)
					}
				</div>
			</div>
		</header>
		<script is:inline>
			// Inline, so the height is set before the browser scrolls to a URL fragment
			(function () {
				var header = document.querySelector(".site-header");
				function setHeight() {
					document.documentElement.style.setProperty(
						"--header-height",
						header.offsetHeight + "px",
					);
				}
				setHeight();
				new ResizeObserver(setHeight).observe(header);
			})();
		</script>

		<main id="main" tabindex="-1" class:list={[business && "bb-has-business", isPost && "bb-is-post"]}>
			<slot />
			{business && <BlogBusiness details={business} contact={contactOn} />}
			{shareOn && <BlogShare url={shareUrl} title={pageTitle ?? title} x={handleOf(socialTyped.x)} bluesky={handleOf(socialTyped.bluesky)} />}
			{signup && <BlogSignup {...signup} />}
		</main>
		{slideUp && <BlogSlideUp {...slideUp} />}
		{signup && <BlogForms turnstile={!!signup.siteKey} />}

		<footer class="site-footer band">
			<div class="frame site-footer__grid">
				<div class="site-footer__brand">
					<a href="/" class="brand">
						{
							siteLogo ? (
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="brand__logo"
								/>
							) : (
								<>
									{monogram && (
										<span class="brand__mark" aria-hidden="true">
											{monogram}
										</span>
									)}
									<span class="brand__name">{siteTitle}</span>
								</>
							)
						}
					</a>
					{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
					<BlogSocial profiles={profiles} />
				</div>
				{
					menuItems.length > 0 && (
						<nav class="site-footer__col" aria-labelledby="footer-navigate">
							<h2 id="footer-navigate" class="eyebrow">
								Navigate
							</h2>
							<ul class="site-footer__links">
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="site-footer__col">
					<h2 class="eyebrow">Connect</h2>
					<ul class="site-footer__links">
						<li>
							<a href="/rss.xml">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									><path d="M4 11a9 9 0 0 1 9 9"></path><path
										d="M4 4a16 16 0 0 1 16 16"></path><circle
										cx="5"
										cy="19"
										r="1"></circle></svg
								>
								RSS feed
							</a>
						</li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__widgets">
					<WidgetArea name="footer" />
				</div>
			</div>
			<div class="band site-footer__bottom">
				<div class="frame site-footer__bottom-inner">
					<p class="site-footer__meta">
						{`© ${year} ${siteTitle}.`}
						{" Powered by "}
						<a href="https://emdashcms.com">EmDash</a>
						{showPoweredBy && (
							<>
								{" · "}
								<a href="https://paulobrien.dev/blog/">Made with Blog Builder</a>
							</>
						)}
					</p>
					<div class="theme-switcher" role="group" aria-label="Color theme">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><path
									d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
									d="M8 21h8M12 17v4"></path></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			// Initialize: the Design tab's preview, then the reader's own choice, then the writer's (Design tab).
			// Only a reader's press writes the cookie.
			const preview = root.getAttribute("data-bb-preview");
			const row = document.cookie.split("; ").find((item) => item.startsWith("theme="));
			const startTheme = preview && preview !== "auto" ? preview : row ? getStoredTheme() : root.getAttribute("data-bb-scheme") || "system";
			root.classList.remove("light", "dark");
			if (startTheme === "light" || startTheme === "dark") root.classList.add(startTheme);
			updateActiveBtn(startTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					-webkit-text-size-adjust: 100%;
				}

				/*
				 * Fragment targets clear the sticky header. Not a scroll-padding
