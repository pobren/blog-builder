			.site-search :global(.site-search-input):focus {
				outline: 2px solid transparent;
				border-color: var(--color-muted);
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			.site-search__kbd {
				position: absolute;
				inset-inline-end: 8px;
				top: 50%;
				translate: 0 -50%;
				padding: 2px 6px;
				border-radius: var(--radius-sm);
				background: var(--color-bg);
				box-shadow: inset 0 0 0 1px var(--color-border);
				color: var(--color-muted);
				font-size: 11px;
				font-weight: 500;
				line-height: 1.4;
				pointer-events: none;
				transition: opacity var(--transition-fast);
			}

			.site-search:focus-within .site-search__kbd,
			.site-search:has(input:not(:placeholder-shown)) .site-search__kbd {
				opacity: 0;
			}

			.site-search :global(.site-search-results) {
				top: calc(100% + 8px);
				inset-inline: auto 0;
				width: max(100%, 380px);
				margin-top: 0;
				padding: 6px;
				border: 0;
				border-radius: 14px;
				background: var(--color-surface);
				box-shadow: var(--shadow-lg);
				max-height: min(420px, 70vh);
				overflow-y: auto;
				z-index: 60;
			}

			.site-search :global(.emdash-live-search-loading),
			.site-search :global(.emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			.site-search :global(.site-search-result) {
				display: grid;
				gap: 2px;
				padding: 10px 12px;
				border: 0;
				border-radius: var(--radius);
				color: var(--color-text);
				text-decoration: none;
			}

			.site-search :global(.site-search-result):hover,
			.site-search :global(.site-search-result):focus,
			.site-search :global(.site-search-result.focused) {
				background: var(--color-fill);
				outline: 2px solid transparent;
				outline-offset: -2px;
			}

			.site-search :global(.emdash-live-search-result-title) {
				order: 2;
				font-size: var(--font-size-sm);
				font-weight: 500;
			}

			.site-search :global(.emdash-live-search-result-collection) {
				order: 1;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
			}

			.site-search :global(.emdash-live-search-result-snippet) {
				order: 3;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				font-size: var(--font-size-xs);
				line-height: var(--leading-snug);
				color: var(--color-text-secondary);
			}

			.site-search :global(.emdash-live-search-result-snippet mark) {
				padding: 0 2px;
				border-radius: 3px;
				background: var(--color-fill-strong);
				color: var(--color-text);
			}

			.site-search-link {
				display: none;
			}

			/* Footer */
			.site-footer__grid {
				display: grid;
				grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
				gap: var(--spacing-10);
				padding-block: var(--spacing-16) var(--spacing-12);
			}

			.site-footer__tagline {
				margin-top: var(--spacing-4);
				max-width: 34ch;
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.site-footer__col .eyebrow,
			.site-footer__widgets :global(.widget__title) {
				margin-bottom: var(--spacing-4);
			}

			.site-footer__links {
				display: grid;
				gap: var(--spacing-3);
				list-style: none;
			}

			.site-footer__links a {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-2);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.site-footer__links a:hover {
				color: var(--color-text);
			}

			.site-footer__links svg {
				width: 15px;
				height: 15px;
			}

			.site-footer__widgets :global(.widget-area) {
				display: grid;
				gap: var(--spacing-8);
			}

			.site-footer__widgets :global(.widget__title) {
				font-family: var(--font-mono);
				font-size: var(--font-size-label);
				font-weight: 500;
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
			}

			.site-footer__widgets :global(.widget__content) {
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
				color: var(--color-text-secondary);
			}

			.site-footer__widgets :global(.widget__content ul) {
				display: grid;
				gap: var(--spacing-3);
				list-style: none;
			}

			.site-footer__bottom-inner {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-4);
				padding-block: var(--spacing-5);
			}

			.site-footer__meta {
				font-size: var(--font-size-xs);
				color: var(--color-muted);
			}

			.site-footer__meta a {
				color: var(--color-text-secondary);
			}

			.theme-switcher {
				display: inline-flex;
				gap: 2px;
				padding: 3px;
				border-radius: var(--radius-full);
				background: var(--color-fill);
			}

			.theme-btn {
				display: grid;
				place-items: center;
				width: 1.75rem;
				height: 1.75rem;
				padding: 0;
				border: 0;
				border-radius: var(--radius-full);
				background: transparent;
				color: var(--color-muted);
				cursor: pointer;
				transition:
					color var(--transition-fast),
					background-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
			}

			.theme-btn.active {
				background: var(--color-surface);
				color: var(--color-text);
				box-shadow:
					0 0 0 1px var(--color-ring),
					var(--shadow-sm);
			}

			.theme-btn svg {
				width: 15px;
				height: 15px;
			}

			@media (forced-colors: active) {
				.site-nav a[aria-current],
				.theme-btn.active {
					border: 1px solid CanvasText;
				}
			}

			@media (max-width: 900px) {
				.site-footer__grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: var(--spacing-8);
					padding-block: var(--spacing-12) var(--spacing-10);
				}

				.site-footer__brand {
					grid-column: 1 / -1;
				}
			}

			/* Phones: brand and actions on the first row, the nav on its own row */
			@media (max-width: 640px) {
				.site-header {
					position: relative;
				}

				.site-header__inner {
					flex-wrap: wrap;
					row-gap: var(--spacing-1);
					padding-block: var(--spacing-3) var(--spacing-2);
				}

				.site-nav {
					order: 3;
					flex-basis: 100%;
					margin-inline-start: -10px;
				}

				.site-nav a {
					padding: 8px 10px;
				}

				.site-search {
					display: none;
				}

				.site-search-link {
					display: inline-grid;
					width: 2.5rem;
					height: 2.5rem;
				}
			}

			@media (max-width: 560px) {
				.site-footer__grid {
					grid-template-columns: minmax(0, 1fr);
				}

				.brand__name {
					max-width: 9rem;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K focuses the header search
			const searchInput =
				document.querySelector<HTMLInputElement>(".site-search-input");
			const kbd = document.querySelector(".site-search__kbd span");
			if (kbd && !/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
				kbd.textContent = "Ctrl K";
			}
			document.addEventListener("keydown", (e) => {
				if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== "k") return;
				// The header search is hidden on small screens; leave the shortcut to the browser there
				if (!searchInput || searchInput.getClientRects().length === 0) return;
				e.preventDefault();
				searchInput.focus();
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
